# Copy to .env in this directory. Configure all secrets locally, never in Git/chat.
# Each nonempty secret needs 32-512 non-whitespace characters. Use independent random values.
# Empty API key or download secret keeps /v1 disabled (HTTP 503).
PARTNER_API_KEY=
PARTNER_DOWNLOAD_SECRET=

# Service name: symphony. Local testing first; configure the real HTTPS domain on deployment.
# Example only: https://symphony.example.com/v1 (replace with your actual domain).
PARTNER_PUBLIC_BASE_URL=http://127.0.0.1:8787/v1

# Optional callbacks. Leave empty for query-only integration.
# Exact, comma-separated HTTPS URLs; private network destinations are rejected.
PARTNER_CALLBACK_URLS=
PARTNER_DEFAULT_CALLBACK_URL=
PARTNER_WEBHOOK_SECRET=

# Ubuntu installer selects chrome on x86_64, chromium on ARM64.
# Leave empty on Windows to retain the existing browser selection.
WORKBENCH_BROWSER_CHANNEL=
