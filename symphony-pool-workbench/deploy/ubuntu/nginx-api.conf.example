# Add inside an existing HTTPS server block after configuring the domain and certificate.
# Only the partner API is public. Management pages and noVNC are accessed over SSH.
location ^~ /v1/ {
    client_max_body_size 110m;
    proxy_pass http://127.0.0.1:8787;
    proxy_set_header Host 127.0.0.1:8787;
    proxy_http_version 1.1;
    proxy_request_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
}

location / {
    return 404;
}
