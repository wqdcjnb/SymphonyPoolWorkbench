[Unit]
Description=Symphony video workbench and private browser desktop
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@@APP_ROOT@@
ExecStart=/usr/bin/bash "@@APP_ROOT@@/deploy/ubuntu/run-desktop.sh"
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
